% ============================================================================
% 14. Detailed System Internals
% ============================================================================
\chapter{Detailed System Internals}
\section{End-to-End Request Lifecycle}
This section presents the complete internal lifecycle of user requests in both text and voice modes, including routing, memory, retrieval, tool calls, critique, and response delivery.

\subsection{Text Chat Lifecycle}
\begin{enumerate}[label=\arabic*.]
    \item Frontend sends user text through WebSocket to \texttt{/ws/chat/\{session\_id\}}.
    \item Backend resolves session profile and optional active order context.
    \item A scoped cache key is generated; cache hit returns directly with metadata logging.
    \item On cache miss, the request enters the LangGraph pipeline.
    \item Supervisor classifies intent, Triage plans subtasks, Resolution executes retrieval/tool operations.
    \item Critic approves, rejects (retry), or escalates.
    \item Final output is normalized for readability and persisted to Redis/Mongo.
    \item Assistant response is streamed to UI and surfaced in chat history.
\end{enumerate}

\subsection{Voice Lifecycle}
\begin{enumerate}[label=\arabic*.]
    \item Frontend streams audio chunks to \texttt{/ws/voice-stream/\{session\_id\}}.
    \item Backend accumulates turn chunks and applies silence-based finalization.
    \item Partial transcript and early reply preview are emitted to reduce perceived latency.
    \item Completed turn is transcribed with Whisper and validated through VAD and turn checks.
    \item The transcribed query flows through fast voice reply path or full graph path.
    \item Final text is synthesized to TTS and returned with \texttt{audio\_url}.
\end{enumerate}

\section{Internal Quality Gates}
\begin{itemize}[leftmargin=*]
    \item \textbf{Grounding Gate}: order APIs + FAISS context retrieval before final answer.
    \item \textbf{Critic Gate}: approval required for non-escalated resolution path.
    \item \textbf{Formatting Gate}: response normalization removes malformed markdown/table artifacts.
    \item \textbf{Escalation Gate}: unresolved or sensitive cases are routed to human handoff bundle.
\end{itemize}

\section{Conversation Context Model}
\begin{table}[H]
\centering
\caption{Conversation context fields used across request processing}
\begin{tabularx}{\textwidth}{|l|l|X|}
\hline
\textbf{Field} & \textbf{Source} & \textbf{Purpose} \\
\hline
\path|session_id| & Frontend / generated & Conversation continuity and storage keying \\
\hline
\path|order_id| & explicit payload / regex / profile & Order-specific grounding for responses \\
\hline
\path|intent| & Supervisor/Critic metadata & Analytics and queue triage \\
\hline
\path|priority| & Triage/Critic metadata & Escalation urgency and dashboard grouping \\
\hline
\path|history| & Redis/Mongo & Multi-turn reasoning continuity \\
\hline
\end{tabularx}
\end{table}

