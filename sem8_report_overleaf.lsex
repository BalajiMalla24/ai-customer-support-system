\chapter{Experimental Evaluation and Trace Samples}
\section{Evaluation Setup}
Experiments were run on representative scenarios spanning order tracking, delayed delivery frustration, refund requests, technical troubleshooting, and ambiguous intent prompts.

\section{Representative Trace 1: Order Delay Complaint}
\begin{lstlisting}[language={},caption={Trace: order delay complaint trajectory}]
Input: "My order SE-8738 is delayed again. What is happening?"
Supervisor: intent=order_support, priority=P2
Triage: tasks=[fetch_order, retrieve_policy, craft_resolution]
Resolution: order_status=In Transit, eta=5 days, policy_context=delay guidance
Critic: APPROVE (grounded, empathetic, complete)
Output: status + ETA + next steps + escalation option
\end{lstlisting}

\section{Representative Trace 2: Voice Turn with Partial Transcript}
\begin{lstlisting}[language={},caption={Trace: voice pipeline events}]
start_turn -> chunk_stream -> partial_transcript -> early_reply
auto-silence finalize -> transcribe -> detect_turn_end
fast_voice_reply -> synthesize -> turn_result(audio_url)
\end{lstlisting}

\section{Consistency Run Summary}
\begin{table}[H]
\centering
\caption{Repeated prompt consistency sample}
\begin{tabular}{|l|c|c|c|}
\hline
\textbf{Prompt Type} & \textbf{Runs} & \textbf{Fact Consistency} & \textbf{Style Variance} \\
\hline
Order status query & 10 & High & Moderate \\
\hline
Refund policy query & 10 & High & Low \\
\hline
Technical troubleshooting & 10 & Medium-High & Moderate \\
\hline
\end{tabular}
\end{table}

\section{Failure Mode Review}
\begin{itemize}[leftmargin=*]
    \item Broken markdown from LLM outputs: mitigated by response normalization layer.
    \item Voice start/end instability: mitigated by manual-stop guard in UI turn loop.
    \item Missing order events for existing DB rows: mitigated by empty-list return fallback.
\end{itemize}

% ============================================================================
% 19. Deployment, Operations, and Security Notes
% ============================================================================
\chapter{Deployment, Operations, and Security Notes}
\section{Deployment Topology (Recommended)}
\begin{itemize}[leftmargin=*]
    \item Frontend static build behind CDN or Nginx.
    \item FastAPI app behind reverse proxy with WebSocket support.
    \item Redis and MongoDB in managed/private network segment.
    \item Optional Ollama worker node for local fallback route.
\end{itemize}

\section{Operational Runbook}
\begin{enumerate}[label=\arabic*.]
    \item Validate environment variables and service connectivity at startup.
    \item Confirm FAISS index availability and Redis/Mongo health checks.
    \item Monitor queue growth and escalation rate in Admin dashboard.
    \item Rotate logs and purge temporary voice artifacts on schedule.
\end{enumerate}

\section{Security and Governance Considerations}
\begin{itemize}[leftmargin=*]
    \item Add authentication and role-based access for admin endpoints.
    \item Restrict CORS origins for production deployment.
    \item Protect secrets via vault/env manager and avoid source-controlled credentials.
    \item Add PII redaction and retention policies for support logs.
\end{itemize}

