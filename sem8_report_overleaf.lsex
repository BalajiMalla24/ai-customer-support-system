\appendix
\chapter{Reproducibility Notes}
\section{Backend Startup}
\begin{verbatim}
python -m uvicorn backend.main:app --reload
\end{verbatim}

\section{Frontend Startup}
\begin{verbatim}
cd frontend
npm install
npm run dev
\end{verbatim}

\section{Optional Services}
\begin{verbatim}
# Redis via docker compose
docker compose up -d

# Optional local LLM runtime
ollama serve
\end{verbatim}

\end{document}
