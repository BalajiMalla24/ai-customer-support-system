\chapter{API Contract and Integration Details}
\section{REST Endpoints}
\begin{longtable}{|p{2.1cm}|p{4.0cm}|p{7.0cm}|}
\hline
\textbf{Method} & \textbf{Path} & \textbf{Purpose} \\
\hline
GET & \path|/api/history/{session_id}| & Retrieve historical messages for chat reconstruction \\
\hline
GET & \path|/api/mock/orders| & Fetch order list for My Orders screen \\
\hline
GET & \path|/api/mock/order/{order_id}| & Fetch single order details and status \\
\hline
GET & \path|/api/mock/order/{order_id}/events| & Fetch timeline events for selected order \\
\hline
POST & \path|/api/mock/order| & Create a new mock order record \\
\hline
POST & \path|/api/mock/order/{order_id}/event| & Append event and update order state \\
\hline
POST & \path|/api/voice/transcribe| & File-upload voice turn STT + response + TTS \\
\hline
GET & \path|/api/admin/metrics| & Dashboard aggregate metrics \\
\hline
GET & \path|/api/admin/queue| & Escalation queue and active issues \\
\hline
GET & \path|/api/admin/analytics| & Intent and priority breakdown analytics \\
\hline
POST & \path|/api/admin/kb/upload| & Append KB content and trigger reindex \\
\hline
\end{longtable}

\section{WebSocket Message Shapes}
\subsection{Chat WebSocket Input}
\begin{lstlisting}[language={},caption={Chat payload shapes}]
