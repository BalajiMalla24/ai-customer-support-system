// Structured payload with explicit order grounding
{
  "type": "chat_message",
  "text": "Please confirm current status",
  "order_id": "SE-8738"
}
\end{lstlisting}

\subsection{Voice Stream Control Messages}
\begin{lstlisting}[language={},caption={Voice stream control messages}]
