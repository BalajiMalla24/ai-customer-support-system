\section{Agent Roles}
\begin{table}[H]
\centering
\caption{Agent responsibilities}
\begin{tabularx}{\textwidth}{|l|l|X|}
\hline
\textbf{Component} & \textbf{Role Type} & \textbf{Responsibility} \\
\hline
Supervisor & Planner/Router & Intent classification, confidence routing, escalation trigger \\
\hline
Triage & Planner & Subtask breakdown, priority assignment, response strategy \\
\hline
Resolution & Executor & Tool calls (order fetch/summary/RAG), response drafting \\
\hline
Critic & Verifier & Quality, safety, and grounding checks; approve/reject/escalate \\
\hline
Escalation Bundle & Handoff Support & Human-readable context package for unresolved sessions \\
\hline
\end{tabularx}
\end{table}

\section{Offline / Local Components}
\begin{itemize}[leftmargin=*]
    \item \textbf{Ollama} local model as fallback route for selected tasks and escalation bundle generation.
    \item \textbf{Whisper} local speech-to-text model for voice transcription.
    \item \textbf{FAISS} local vector index for retrieval from the project knowledge base.
\end{itemize}
 
% ============================================================================
% 5. Memory Integration & RAG
% ============================================================================
\chapter{Memory Integration and Knowledge Retrieval (RAG)}
\section{RAG Setup}
RAG retrieves support-relevant context from \texttt{kb/shopeasy\_faq.txt}. The FAISS index is loaded or rebuilt at startup. Retrieval results are injected into agent prompts to improve factual grounding.

\section{Contextual Memory}
\begin{itemize}[leftmargin=*]
    \item \textbf{Redis}: session history, session metadata (intent/priority/order context), user profile fields.
    \item \textbf{MongoDB}: durable message history, session activity, queue analytics, order documents.
    \item \textbf{Fallback strategy}: if Redis is unavailable, profile memory falls back to in-process store.
\end{itemize}

\section{Memory and Grounding Outcome}
The system preserves conversation continuity and order context across chat/voice turns. This reduced context loss and improved answer consistency for repeated order-related queries.
